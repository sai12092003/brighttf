# Copy this file to .env and fill in real values. Never commit the real .env file.

APP_ENV=local
APP_URL=http://localhost:8000
APP_KEY=change-this-to-a-long-random-string

# DB_DRIVER: "pgsql" for local development, "mysql" for cPanel production.
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=brighttoday_dev
DB_USER=postgres
DB_PASS=postgres

MAIL_FROM_ADDRESS=brighttfhead@gmail.com
MAIL_FROM_NAME="Bright Today Foundation"

# SMTP is optional locally; when blank, Mailer logs mail to storage/logs/mail.log instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
