# Bright Today Foundation — public webroot .htaccess

# ---- Directory listing / dotfiles ----
Options -Indexes -MultiViews
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Never serve source/data files even if they end up in this folder by mistake.
<FilesMatch "\.(sql|log|md|env|ini|bak|sh)$">
    Require all denied
</FilesMatch>

# ---- Security headers ----
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---- Front controller routing + force HTTPS ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (SSL is live on this domain). Behind a reverse proxy (e.g. Dokploy/Traefik)
    # that terminates TLS, %{HTTPS} is always "off" from Apache's point of view, so also trust
    # X-Forwarded-Proto to avoid a redirect loop.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Let real files and directories (assets, uploads, admin/*.php) resolve normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the front controller (public pages / routes.php).
    RewriteRule ^ index.php [L]
</IfModule>

# ---- PHP hardening ----
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
